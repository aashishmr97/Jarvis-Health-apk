{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with biometrics, goals, and safety preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Auth UID of the user" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Email address" },
        "weight": { "type": "number", "description": "Weight in kg" },
        "goal": { "type": "string", "description": "Primary goal" },
        "streakDays": { "type": "number", "description": "Consistency streak" }
      },
      "required": ["id", "name"]
    },
    "Workout": {
      "title": "Workout",
      "description": "Completed workout session log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Workout ID" },
        "title": { "type": "string", "description": "Workout title" },
        "date": { "type": "string", "description": "ISO date string" },
        "totalVolumeLoadKg": { "type": "number", "description": "Total volume in kg" }
      },
      "required": ["id", "title", "date"]
    },
    "Meal": {
      "title": "Meal",
      "description": "Logged meal diary item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Meal ID" },
        "mealType": { "type": "string", "description": "Meal type" },
        "time": { "type": "string", "description": "Logged time" },
        "totalCalories": { "type": "number", "description": "Total calories" }
      },
      "required": ["id", "mealType", "totalCalories"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Top-level user profile"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "User completed workouts subcollection"
    },
    "/users/{userId}/meals/{mealId}": {
      "schema": "Meal",
      "description": "User logged meals subcollection"
    }
  }
}
